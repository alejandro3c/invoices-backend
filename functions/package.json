{
  "name": "functions",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "npm run build && firebase emulators:start --project=icy-invoices --import=../exported-dev-data --export-on-exit=./exported-dev-data",
    "pro": "npm run build && firebase emulators:start --project=icy-invoices --import=../exported-pro-data --export-on-exit=./exported-pro-data",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "kill": "npx kill-port 4443"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "puppeteer": "^25.9.0"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
