{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "dev"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 4442
    },
    "firestore": {
      "port": 4443,
      "websocketPort": 4447
    },
    "auth": {
      "port": 4441
    },
    "storage": {
      "port": 4444
    },
    "hub": {
      "port": 4445
    },
    "logging": {
      "port": 4446
    },
    "eventarc": {
      "port": 4448
    },
    "tasks": {
      "port": 4449
    },
    "ui": {
      "enabled": true,
      "port": 4440
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
